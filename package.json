{
  "name": "finanzas-web",
  "version": "1.0.0",
  "description": "Sistema de Gestion Financiera - Fullstack Web Application",
  "license": "MIT",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build": "cd sidan-frontend && npm install && npm run build && cd ../backend && npm install",
    "dev": "cd sidan-frontend && npm run dev",
    "dev:backend": "cd backend && node server.js",
    "setup-git": "node scripts/setup-git.mjs",
    "auto-push": "node scripts/auto-push.mjs",
    "push": "node scripts/sync-push.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.3",
    "pg": "^8.13.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
