# ============================================
# Variables de entorno — Sistema de Finanzas
# ============================================
# Copiar este archivo como .env y completar los valores

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3001

# ── Base de datos MySQL ─────────────────────
# Opción 1: Variables individuales
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root
DB_NAME=finanzas_db
DB_PORT=3306

# Opción 2: URL de conexión completa (para Aiven, PlanetScale, etc.)
# DATABASE_URL=mysql://user:password@host:port/finanzas_db

# Activar SSL para bases de datos en la nube
# DB_SSL=true

# ── Seguridad ───────────────────────────────
JWT_SECRET=finanzas_jwt_secreto_super_seguro_produccion_2024

# ── Entorno ─────────────────────────────────
# NODE_ENV=production
